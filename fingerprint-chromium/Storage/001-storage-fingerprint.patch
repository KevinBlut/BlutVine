--- a/storage/browser/quota/quota_manager_impl.cc
+++ b/storage/browser/quota/quota_manager_impl.cc
@@ -140,6 +140,22 @@ int64_t CalculateReportedQuota(int64_t total_space_bytes,
   base::ClampedNumeric<int64_t> clamped_total_space_bytes(total_space_bytes);
   base::ClampedNumeric<int64_t> clamped_usage_bytes(usage_bytes);
 
+  // BlutVine: --fingerprint-storage-quota=<MB> overrides the quota reported
+  // to every JS quota surface (navigator.storage.estimate(), the legacy
+  // navigator.webkitTemporaryStorage.queryUsageAndQuota(), and
+  // navigator.storageBuckets.estimate()), since this is the single choke point
+  // they all flow through. Usage stays real. Unset → real quota behavior.
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch("fingerprint-storage-quota")) {
+    uint64_t mb = 0;
+    if (base::StringToUint64(
+            command_line->GetSwitchValueASCII("fingerprint-storage-quota"),
+            &mb) &&
+        mb > 0) {
+      return static_cast<int64_t>(mb * 1024ULL * 1024ULL);
+    }
+  }
+
