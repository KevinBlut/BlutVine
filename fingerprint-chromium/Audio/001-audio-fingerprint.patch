+void ApplyAudioNoiseFloat(float* data, size_t length) {
+    auto* cmd = base::CommandLine::ForCurrentProcess();
+    std::string seed_str = cmd->GetSwitchValueASCII(switches::kFingerprint);
+    if (seed_str.empty()) return;
+
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (char c : seed_str) { h ^= static_cast<uint8_t>(c); h *= 0x00000100000001B3ULL; }
+    const char* domain = "audio.buf";
+    for (const char* p = domain; *p; ++p) { h ^= static_cast<uint8_t>(*p); h *= 0x00000100000001B3ULL; }
+
+    const double scale = 1.0 + (static_cast<double>(h & 0xFFFFu) - 32768.0) * 3.0e-11;
+    const float offset = static_cast<float>(
+        (static_cast<double>((h >> 16) & 0xFFFFu) - 32768.0) * 1.0e-7);
+
+    for (size_t i = 0; i < length; ++i) {
+        data[i] = static_cast<float>(data[i] * scale) + offset;
+    }
+}
+
+void ApplyAudioNoiseByte(uint8_t* data, size_t length) {
+    auto* cmd = base::CommandLine::ForCurrentProcess();
+    std::string seed_str = cmd->GetSwitchValueASCII(switches::kFingerprint);
+    if (seed_str.empty()) return;
+
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (char c : seed_str) { h ^= static_cast<uint8_t>(c); h *= 0x00000100000001B3ULL; }
+    const char* domain = "audio.byte";
+    for (const char* p = domain; *p; ++p) { h ^= static_cast<uint8_t>(*p); h *= 0x00000100000001B3ULL; }
+
+    uint8_t noise = static_cast<uint8_t>(h & 0xFF);
+    for (size_t i = 0; i < length; ++i) {
+        data[i] ^= noise;
+    }
+}
+
 }  // namespace fingerprint_collector
