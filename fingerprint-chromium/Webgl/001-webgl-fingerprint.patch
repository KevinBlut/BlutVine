+void ApplyWebGLNoiseByte(uint8_t* data, size_t pixel_count) {
+    auto* cmd = base::CommandLine::ForCurrentProcess();
+    std::string seed_str = cmd->GetSwitchValueASCII(switches::kFingerprint);
+    if (seed_str.empty()) return;
+
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (char c : seed_str)
+        { h ^= static_cast<uint8_t>(c); h *= 0x00000100000001B3ULL; }
+    const char* domain = "webgl.readpixels";
+    for (const char* p = domain; *p; ++p)
+        { h ^= static_cast<uint8_t>(*p); h *= 0x00000100000001B3ULL; }
+
+    for (size_t i = 0; i < pixel_count; ++i) {
+        uint64_t ph = h;
+        ph ^= static_cast<uint64_t>(i); ph *= 0x00000100000001B3ULL;
+        for (int c = 0; c < 4; ++c) {
+            int delta = static_cast<int>(ph & 3) - 1;
+            if (delta == 2) delta = 0;
+            int val = static_cast<int>(data[i * 4 + c]) + delta;
+            if (val < 0) val = 0;
+            if (val > 255) val = 255;
+            data[i * 4 + c] = static_cast<uint8_t>(val);
+            ph >>= 2;
+        }
+    }
+}
+
 }  // namespace fingerprint_collector
