+namespace {
+// V8 extension gated behind --fingerprint that installs a window.chrome
+// polyfill (loadTimes, csi, runtime, app) and strips CDP/ChromeDriver
+// automation globals (cdc_*, __webdriver*, __selenium*).
+constexpr char kFingerprintExtensionSource[] =
+    // window.chrome polyfill
+    "var chrome;"
+    "if (!chrome) chrome = {};"
+    "chrome.loadTimes = function() {"
+    "  return {requestTime: 0, startLoadTime: 0, commitLoadTime: 0,"
+    "    finishDocumentLoadTime: 0, finishLoadTime: 0,"
+    "    firstPaintTime: 0, firstPaintAfterLoadTime: 0,"
+    "    navigationType: 'Other', wasFetchedViaSpdy: false,"
+    "    wasNpnNegotiated: false, npnNegotiatedProtocol: 'unknown',"
+    "    wasAlternateProtocolAvailable: false,"
+    "    connectionInfo: 'unknown'};"
+    "};"
+    "chrome.csi = function() {"
+    "  return {startE: Date.now(), onloadT: Date.now(),"
+    "    pageT: 0, tran: 15};"
+    "};"
+    "chrome.runtime = {};"
+    "chrome.app = {isInstalled: false};"
+    // cdc_ / automation globals strip
+    "(function(){"
+    "  var blocked=['cdc_','__webdriver_','__webdriver',"
+    "    '__selenium','__driver_evaluate','__webdriver_evaluate',"
+    "    '__fxdriver_evaluate','__driver_unwrapped',"
+    "    '__webdriver_unwrapped','__fxdriver_unwrapped',"
+    "    '__selenium_evaluate','__selenium_unwrapped',"
+    "    '__fxdriver_evaluate','__lastWatirAlert',"
+    "    '__lastWatirConfirm','__lastWatirPrompt'];"
+    "  blocked.forEach(function(name){"
+    "    try{Object.defineProperty(globalThis,name,"
+    "      {value:undefined,configurable:false,writable:false,"
+    "       enumerable:false});}catch(e){}"
+    "  });"
+    "  var origDP=Object.defineProperty;"
+    "  Object.defineProperty=function(o,p,d){"
+    "    if(typeof p==='string'&&(p.indexOf('cdc_')===0"
+    "      ||p.indexOf('__webdriver')===0"
+    "      ||p.indexOf('__selenium')===0"
+    "      ||p.indexOf('__$webdriver')===0))return o;"
+    "    return origDP.apply(this,arguments);"
+    "  };"
+    "})();";
+}  // namespace
+
+void HeadlessContentRendererClient::RenderThreadStarted() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("fingerprint"))
+    return;
+  blink::WebScriptController::RegisterExtension(
+      std::unique_ptr<v8::Extension>(
+          new v8::Extension("fingerprint",
+                            kFingerprintExtensionSource)));
+}
