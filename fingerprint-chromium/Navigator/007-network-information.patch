+WebConnectionType ParseConnectionTypeString(const std::string& s) {
+  if (s == "cellular") return kWebConnectionTypeCellular4G;
+  if (s == "bluetooth") return kWebConnectionTypeBluetooth;
+  if (s == "ethernet") return kWebConnectionTypeEthernet;
+  if (s == "wifi") return kWebConnectionTypeWifi;
+  if (s == "wimax") return kWebConnectionTypeWimax;
+  if (s == "other") return kWebConnectionTypeOther;
+  if (s == "none") return kWebConnectionTypeNone;
+  return kWebConnectionTypeUnknown;
+}
+
+WebEffectiveConnectionType ParseEctString(const std::string& s) {
+  if (s == "slow-2g") return WebEffectiveConnectionType::kTypeSlow2G;
+  if (s == "2g") return WebEffectiveConnectionType::kType2G;
+  if (s == "3g") return WebEffectiveConnectionType::kType3G;
+  return WebEffectiveConnectionType::kType4G;
+}
+
