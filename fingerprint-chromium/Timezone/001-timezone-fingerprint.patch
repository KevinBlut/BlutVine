diff --git a/headless/lib/headless_content_main_delegate.cc b/headless/lib/headless_content_main_delegate.cc
index 36afd34701..4e943fdeb9 100644
--- a/headless/lib/headless_content_main_delegate.cc
+++ b/headless/lib/headless_content_main_delegate.cc
@@ -236,6 +236,17 @@ std::optional<int> HeadlessContentMainDelegate::BasicStartupComplete() {
   if (command_line->HasSwitch(::switches::kProcessType)) {
     return std::nullopt;
   }
+  // BlutVine: when --fingerprint-location is supplied but --lang is not,
+  // forward it so the application locale (Accept-Language, Intl.*, CSS
+  // :lang()) agrees with navigator.language(s), which Navigator/002 already
+  // derives from the same switch. Uses the raw "fingerprint-location" string
+  // because headless does not depend on components/ungoogled.
+  if (!command_line->HasSwitch(::switches::kLang) &&
+      command_line->HasSwitch("fingerprint-location")) {
+    command_line->AppendSwitchASCII(
+        ::switches::kLang,
+        command_line->GetSwitchValueASCII("fingerprint-location"));
+  }
   // The DevTools remote debugging pipe file descriptors need to be checked
   // before any other files are opened, see https://crbug.com/1423048.
 #if BUILDFLAG(IS_WIN)
