+// Function defined in third_party/blink/public/web/blink.h.
+void BlutVineSetTimeZoneOverride(const std::string& iana_id) {
+  if (iana_id.empty()) {
+    return;
+  }
+
+  auto result = TimeZoneController::SetTimeZoneOverride(
+      String::FromUtf8(iana_id));
+
+  // The handle is intentionally leaked: TimeZoneOverride's destructor calls
+  // ClearTimeZoneOverride(), which would restore the host (real) timezone as
+  // soon as our unique_ptr went out of scope. The override must survive for
+  // the lifetime of the renderer process.
+  static base::NoDestructor<
+      std::unique_ptr<TimeZoneController::TimeZoneOverride>>
+      leaked_handle(nullptr);
+  if (result.handle) {
+    *leaked_handle = std::move(result.handle);
+  }
+}
+
 }  // namespace blink
