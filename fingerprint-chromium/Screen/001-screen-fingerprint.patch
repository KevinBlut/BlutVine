+void HandleFingerprintScreenBridge(base::CommandLine& command_line,
+                                   HeadlessBrowser::Options& options) {
+  if (!command_line.HasSwitch("fingerprint-screen-width") ||
+      !command_line.HasSwitch("fingerprint-screen-height")) {
+    return;
+  }
+
+  if (command_line.HasSwitch(switches::kWindowSize) ||
+      command_line.HasSwitch(switches::kScreenInfo)) {
+    return;
+  }
+
+  int screen_width = 0;
+  int screen_height = 0;
+  base::StringToInt(
+      command_line.GetSwitchValueASCII("fingerprint-screen-width"),
+      &screen_width);
+  base::StringToInt(
+      command_line.GetSwitchValueASCII("fingerprint-screen-height"),
+      &screen_height);
+  if (screen_width <= 0 || screen_height <= 0) {
+    return;
+  }
+
+  int avail_width = screen_width;
+  int avail_height = screen_height;
+  if (command_line.HasSwitch("fingerprint-screen-avail-width")) {
+    base::StringToInt(
+        command_line.GetSwitchValueASCII("fingerprint-screen-avail-width"),
+        &avail_width);
+  }
+  if (command_line.HasSwitch("fingerprint-screen-avail-height")) {
+    base::StringToInt(
+        command_line.GetSwitchValueASCII("fingerprint-screen-avail-height"),
+        &avail_height);
+  }
+
+  double dpr = 1.0;
+  if (command_line.HasSwitch("fingerprint-screen-device-pixel-ratio")) {
+    base::StringToDouble(
+        command_line.GetSwitchValueASCII("fingerprint-screen-device-pixel-ratio"),
+        &dpr);
+  }
+  if (dpr <= 0.0) {
+    dpr = 1.0;
+  }
+
+  int taskbar_bottom = screen_height - avail_height;
+  if (taskbar_bottom < 0) {
+    taskbar_bottom = 0;
+  }
+  int taskbar_right = screen_width - avail_width;
+  if (taskbar_right < 0) {
+    taskbar_right = 0;
+  }
+
+  constexpr int kChromeUiHeight = 85;
+  int window_height = avail_height - kChromeUiHeight;
+  if (window_height < 100) {
+    window_height = avail_height;
+  }
+
+  options.screen_info_spec = base::ReplaceStringPlaceholders(
+      "{$1,$2 $3x$4 colorDepth=24 devicePixelRatio=$5$6$7}",
+      {
+          base::NumberToString(0),
+          base::NumberToString(0),
+          base::NumberToString(screen_width),
+          base::NumberToString(screen_height),
+          base::NumberToString(dpr),
+          taskbar_bottom > 0
+              ? " workAreaBottom=" + base::NumberToString(taskbar_bottom)
+              : "",
+          taskbar_right > 0
+              ? " workAreaRight=" + base::NumberToString(taskbar_right)
+              : "",
+      },
+      nullptr);
+
+  options.window_size =
+      gfx::Size(avail_width, window_height);
+}
