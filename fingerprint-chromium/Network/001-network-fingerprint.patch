+std::optional<net::ReferrerPolicy> ParseReferrerPolicySwitch(
+    const std::string& value) {
+  if (value == "no-referrer")
+    return net::ReferrerPolicy::NO_REFERRER;
+  if (value == "origin")
+    return net::ReferrerPolicy::ORIGIN;
+  if (value == "same-origin")
+    return net::ReferrerPolicy::CLEAR_ON_TRANSITION_CROSS_ORIGIN;
+  if (value == "strict-origin")
+    return net::ReferrerPolicy::ORIGIN_CLEAR_ON_TRANSITION_FROM_SECURE_TO_INSECURE;
+  if (value == "strict-origin-when-cross-origin")
+    return net::ReferrerPolicy::REDUCE_GRANULARITY_ON_TRANSITION_CROSS_ORIGIN;
+  if (value == "origin-when-cross-origin")
+    return net::ReferrerPolicy::ORIGIN_ONLY_ON_TRANSITION_CROSS_ORIGIN;
+  if (value == "unsafe-url")
+    return net::ReferrerPolicy::NEVER_CLEAR;
+  return std::nullopt;
+}
