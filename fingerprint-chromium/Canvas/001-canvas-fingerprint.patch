+void ApplyCanvasNoiseRGBA(uint8_t* data, size_t width, size_t height,
+                           size_t row_bytes) {
+    auto* cmd = base::CommandLine::ForCurrentProcess();
+    std::string seed_str = cmd->GetSwitchValueASCII(switches::kFingerprint);
+    if (seed_str.empty()) return;
+
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (char c : seed_str)
+        { h ^= static_cast<uint8_t>(c); h *= 0x00000100000001B3ULL; }
+    const char* domain = "canvas.rgba";
+    for (const char* p = domain; *p; ++p)
+        { h ^= static_cast<uint8_t>(*p); h *= 0x00000100000001B3ULL; }
+
+    for (size_t y = 0; y < height; ++y) {
+        uint8_t* row = data + y * row_bytes;
+        for (size_t x = 0; x < width; ++x) {
+            uint64_t ph = h;
+            ph ^= static_cast<uint64_t>(x); ph *= 0x00000100000001B3ULL;
+            ph ^= static_cast<uint64_t>(y); ph *= 0x00000100000001B3ULL;
+
+            for (int c = 0; c < 4; ++c) {
+                int delta = static_cast<int>(ph & 3) - 1;
+                if (delta == 2) delta = 0;
+                int val = static_cast<int>(row[x * 4 + c]) + delta;
+                if (val < 0) val = 0;
+                if (val > 255) val = 255;
+                row[x * 4 + c] = static_cast<uint8_t>(val);
+                ph >>= 2;
+            }
+        }
+    }
+}
+
+void ApplyMeasureTextNoise(double* values, size_t count,
+                           const std::string& text) {
+    auto* cmd = base::CommandLine::ForCurrentProcess();
+    std::string seed_str = cmd->GetSwitchValueASCII(switches::kFingerprint);
+    if (seed_str.empty()) return;
+
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (char c : seed_str)
+        { h ^= static_cast<uint8_t>(c); h *= 0x00000100000001B3ULL; }
+    const char* domain = "measuretext";
+    for (const char* p = domain; *p; ++p)
+        { h ^= static_cast<uint8_t>(*p); h *= 0x00000100000001B3ULL; }
+
+    for (size_t i = 0; i < count; ++i) {
+        uint64_t vh = h;
+        vh ^= static_cast<uint64_t>(i); vh *= 0x00000100000001B3ULL;
+        for (char tc : text)
+            { vh ^= static_cast<uint8_t>(tc); vh *= 0x00000100000001B3ULL; }
+        double jitter =
+            static_cast<double>(static_cast<int64_t>(vh % 1001)) / 1000.0 -
+            0.5;
+        values[i] += jitter;
+    }
+}
+
